{
  "version": 1,
  "columns": [
    {
      "id": "28b8b0cd-81ea-447c-b7a8-2d05daefd855",
      "name": "To Do",
      "role": "todo",
      "icon": "layers",
      "color": "#6b7280"
    },
    {
      "id": "ed873612-be49-4071-94d2-c221fe4413ba",
      "name": "Planning",
      "icon": "map",
      "color": "#8b5cf6",
      "autoSpawn": true,
      "permissionMode": "plan",
      "modelOverride": "opus",
      "effortOverride": "xhigh",
      "planExitTarget": "Executing"
    },
    {
      "id": "5358e3a9-8cf7-4818-b33b-71a98536a37e",
      "name": "Executing",
      "icon": "square-terminal",
      "autoSpawn": true,
      "modelOverride": "opus",
      "effortOverride": "xhigh",
      "automations": {
        "onTurnEnd": [
          {
            "name": "On to Code Review",
            "type": "move_to_column",
            "finalLine": "Findings: applied",
            "maxRuns": 4,
            "targetColumn": "Code Review"
          },
          {
            "name": "Design hold",
            "type": "notify",
            "finalLine": "Design: waiting on you",
            "title": "{{title}}",
            "body": "Waiting on your design review. Say \"ship it\" to send it on to Code Review."
          },
          {
            "name": "Apply findings",
            "type": "send_message",
            "message": "Check your last message for findings, recommendations or follow-up changes you have not applied yet, and apply them here in this task, not as follow-up tasks. Where one needs a decision, take your recommended option and name the alternative, unless it is a design choice you laid out for the user, which stays theirs. If there are none, say so. Then end your turn with a short summary and one final line, alone.\n\nWrite \"Design: waiting on you\" when the user should see this before it ships: a visible change to a screen, layout, styling, motion, haptics, user-facing copy or store frames, a design choice you laid out for the user, or a task where the user has given design feedback. Keep ending every turn on that line until the user says the design is ready, for example \"ship it\". Once they have, write \"Findings: applied\", on this visit and any later one.\n\nOtherwise write \"Findings: applied\"."
          }
        ]
      }
    },
    {
      "id": "9a7ef24b-2417-4277-bfd3-862250c1b6f7",
      "name": "Code Review",
      "icon": "code",
      "color": "#f59e0b",
      "autoSpawn": true,
      "modelOverride": "opus",
      "effortOverride": "xhigh",
      "sessionTarget": "isolated",
      "sessionSpawnStrategy": "always_spawn_new",
      "automations": {
        "onEnter": [
          {
            "name": "Message",
            "type": "send_message",
            "message": "/code-review {{baseBranch}}",
            "mode": "immediate"
          }
        ],
        "onTurnEnd": [
          {
            "name": "Back for revisions",
            "type": "move_to_column",
            "finalLine": "Verdict: Blocked",
            "maxRuns": 3,
            "targetColumn": "Executing",
            "message": "Code Review sent this back. Do the numbered steps above its verdict, commit (never with the review scope), then end your turn.\n\n{{agentReply}}"
          },
          {
            "name": "On to Testing",
            "type": "move_to_column",
            "finalLine": "Verdict: Ready",
            "maxRuns": 1,
            "targetColumn": "Testing"
          }
        ]
      }
    },
    {
      "id": "91ad5825-f506-4020-91b2-207b28124eb7",
      "name": "Testing",
      "icon": "flask-conical",
      "color": "#06b6d4",
      "autoSpawn": true,
      "modelOverride": "sonnet",
      "effortOverride": "high",
      "automations": {
        "onEnter": [
          {
            "name": "Message",
            "type": "send_message",
            "message": "/pull-request",
            "mode": "immediate"
          }
        ],
        "onTurnEnd": [
          {
            "name": "On to Merge",
            "type": "move_to_column",
            "finalLine": "PR: ready to merge",
            "maxRuns": 1,
            "targetColumn": "Merge"
          }
        ]
      }
    },
    {
      "id": "ed8a6c51-e609-4a87-b2db-bbe6770c5acc",
      "name": "Merge",
      "icon": "merge",
      "color": "#F97316",
      "autoSpawn": true,
      "modelOverride": "sonnet",
      "effortOverride": "high",
      "automations": {
        "onEnter": [
          {
            "name": "Message",
            "type": "send_message",
            "message": "/merge-pull-request",
            "mode": "immediate"
          }
        ],
        "onTurnEnd": [
          {
            "name": "Finish",
            "type": "move_to_column",
            "finalLine": "PR: merged",
            "maxRuns": 1,
            "targetColumn": "Done"
          }
        ]
      }
    },
    {
      "id": "857923ef-41f9-4905-b4e5-11790bc9dc70",
      "name": "Done",
      "role": "done",
      "icon": "circle-check-big",
      "color": "#10b981"
    }
  ],
  "_modifiedBy": "7ef4fd0cb484"
}
