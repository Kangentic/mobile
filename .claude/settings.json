{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/bash-guard.js"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(git:*)",
      "Bash(expo:*)",
      "Bash(eas:*)",
      "Bash(maestro:*)",
      "Bash(adb:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(pwd)",
      "Bash(cat:*)",
      "Bash(touch:*)",
      "Bash(diff:*)",
      "Bash(which:*)",
      "Bash(sort:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(tasklist:*)",
      "Bash(grep:*)",
      "Bash(du:*)",
      "Bash(powershell:*)",
      "Bash(powershell.exe:*)",
      "Bash(gh run:*)",
      "Bash(gh api:*)",
      "Bash(gh workflow:*)",
      "Bash(gh release:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(start:*)",
      "PowerShell(npm *)",
      "PowerShell(npx *)",
      "PowerShell(node *)",
      "PowerShell(git *)",
      "PowerShell(eas *)",
      "PowerShell(maestro *)",
      "PowerShell(adb *)",
      "PowerShell(Remove-Item *)",
      "mcp__kangentic",
      "WebSearch",
      "WebFetch(domain:docs.expo.dev)",
      "WebFetch(domain:reactnative.dev)",
      "WebFetch(domain:docs.maestro.dev)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:nodejs.org)",
      "Skill",
      "mcp__maestro__list_devices",
      "mcp__maestro__inspect_screen",
      "mcp__maestro__take_screenshot",
      "mcp__maestro__cheat_sheet",
      "mcp__firebase__firebase_get_project",
      "mcp__firebase__firebase_list_projects",
      "mcp__firebase__firebase_list_apps",
      "mcp__firebase__firebase_get_sdk_config",
      "mcp__firebase__firebase_get_environment",
      "mcp__firebase__firebase_deploy_status"
    ],
    "ask": [
      "mcp__plugin_expo_expo__build_run",
      "mcp__plugin_expo_expo__build_submit",
      "mcp__plugin_expo_expo__workflow_run",
      "mcp__plugin_expo_expo__appstore_reply_review",
      "mcp__plugin_expo_expo__appstore_delete_review_response",
      "mcp__plugin_expo_expo__playstore_reply_review",
      "mcp__maestro__run_on_cloud",
      "mcp__firebase__messaging_send_message",
      "mcp__firebase__firebase_create_project",
      "mcp__firebase__firebase_create_app",
      "mcp__firebase__firebase_create_android_sha",
      "mcp__firebase__firebase_deploy",
      "mcp__firebase__firebase_init",
      "mcp__firebase__firebase_update_environment"
    ],
    "deny": []
  },
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  }
}
