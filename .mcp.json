{
  "mcpServers": {
    "context7": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "firebase": {
      "command": "cmd",
      "args": [
        "/c",
        "firebase",
        "mcp",
        "--only",
        "core,messaging"
      ]
    }
  }
}
