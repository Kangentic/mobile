{
  "name": "@kangentic/mobile",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kangentic/mobile.git"
  },
  "main": "index.js",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-gesture-handler",
        "react-native-worklets",
        "react-native-svg",
        "@shopify/flash-list",
        "react-native-pager-view",
        "@sentry/react-native"
      ]
    },
    "autolinking": {
      "buildFromSource": [
        "expo-task-manager",
        "unimodules-app-loader"
      ]
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "enriched-markdown": {
    "enableMath": false,
    "enableCodeHighlight": false,
    "enableVideo": false
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "dev:mock": "node scripts/dev.mjs mock",
    "dev:shots": "node scripts/dev.mjs mock --shots",
    "dev:live": "node scripts/dev.mjs live",
    "dev:pair": "node scripts/dev.mjs pair",
    "dev:stub": "node scripts/dev.mjs stub",
    "dev:doctor": "node scripts/dev.mjs doctor",
    "check:install": "node scripts/checkInstallDrift.mjs",
    "clean:staging": "node scripts/cmakeStaging.mjs --prune",
    "verify:staging": "node scripts/cmakeStaging.mjs --verify",
    "pretypecheck": "node scripts/checkInstallDrift.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run tests/unit",
    "test:components": "jest tests/components",
    "sync:branding": "node scripts/syncBranding.mjs",
    "sync:branding:check": "node scripts/syncBranding.mjs --check",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform android",
    "dev:emu": "node scripts/dev.mjs emu",
    "dev:adb": "node scripts/dev.mjs adb",
    "dev:stop": "node scripts/dev.mjs stop"
  },
  "dependencies": {
    "@bacons/text-decoder": "^0.0.0",
    "@kangentic/protocol": "^0.28.0",
    "@notifee/react-native": "9.1.8",
    "@sentry/react-native": "~8.34.0",
    "@shopify/flash-list": "2.3.3",
    "@xterm/addon-webgl": "0.19.0",
    "diff": "^9.0.0",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.20",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.20",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-speech-recognition": "^58.0.1",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.14",
    "katex": "^0.19.1",
    "lucide-react-native": "^1.69.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-enriched-markdown": "^1.1.1",
    "react-native-gesture-handler": "~3.5.0",
    "react-native-get-random-values": "~2.1.0",
    "react-native-pager-view": "10.0.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@kangentic/branding": "^2.13.0",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "patch-package": "^8.0.1",
    "qrcode": "^1.5.4",
    "semver": "^7.8.5",
    "test-renderer": "~1.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "ws": "^8.22.1"
  }
}
